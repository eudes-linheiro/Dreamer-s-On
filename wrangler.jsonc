{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamer-s-on",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreamers-on-db",
      "database_id": "add6a2d5-a472-4d77-ba38-c7054337d8c2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "dreamers-on-photos"
    }
  ]
}
